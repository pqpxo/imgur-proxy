# version 4.0.1
# Copy to .env and keep private. PIA VPN credentials, not necessarily web account login.
PIA_USER=REPLACE_WITH_PIA_VPN_USERNAME
PIA_PASSWORD=REPLACE_WITH_PIA_VPN_PASSWORD
SERVER_REGIONS=Netherlands
# Unused IP on your own LAN, excluded from DHCP
PROXY_IP=REPLACE_WITH_UNUSED_LAN_IP
# Existing Docker macvlan network
MACVLAN_NETWORK=swimgur-macvlan
